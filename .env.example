# Environment Configuration for Privacy-Preserving Offline Legal RAG

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000

# Strict Offline Enforcement
OFFLINE_MODE=true
ALLOW_REMOTE_REQUESTS=false

# Local Inference (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
GENERATION_MODEL=qwen2.5:1.5b
EMBEDDING_BATCH_SIZE=8
GENERATION_TIMEOUT_SECONDS=60

# Data Directories (Defaults to relative paths within workspace)
DATA_DIR=data
ORIGINALS_DIR=data/originals
PROCESSED_DIR=data/processed
CHROMA_DIR=data/chroma
SQLITE_DB_PATH=data/sqlite/legal_rag.db
QUARANTINE_DIR=data/quarantine

# Security & Access Control
JWT_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB

# Retrieval Settings
BM25_K1=1.5
BM25_B=0.75
RETRIEVAL_TOP_K=5
HYBRID_FUSION_ALPHA=0.5 # 0.5 balances semantic & keyword, or RRF
CHUNK_SIZE=600
CHUNK_OVERLAP=100
